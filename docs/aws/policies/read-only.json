{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:GetParameterHistory",
        "ssm:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/SEGMENT",
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/SEGMENT/*"
      ]
    },
    {
      "Sid": "DecryptThroughParameterStoreAndS3",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": ["ssm.REGION.amazonaws.com", "s3.REGION.amazonaws.com"]
        }
      }
    },
    {
      "Sid": "ListAttachments",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET",
      "Condition": {
        "StringLike": { "s3:prefix": ["SEGMENT/", "SEGMENT/*"] }
      }
    },
    {
      "Sid": "ReadAttachments",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::BUCKET/SEGMENT/*"
    },
    {
      "Sid": "ReadVaultSettings",
      "Effect": "Allow",
      "Action": "s3:GetBucketTagging",
      "Resource": "arn:aws:s3:::BUCKET"
    }
  ]
}
